{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://owenbell.local/spec-kit/machine-spec.schema.json",
  "title": "Spec Kit machine spec",
  "type": "object",
  "required": ["spec_version", "id", "title", "status", "behaviors", "acceptance"],
  "properties": {
    "spec_version": { "type": "string" },
    "id": { "type": "string" },
    "title": {
      "type": "object",
      "properties": {
        "zh": { "type": "string" },
        "en": { "type": "string" }
      }
    },
    "status": { "enum": ["draft", "ready", "deprecated"] },
    "in_scope": { "type": "array" },
    "out_of_scope": { "type": "array" },
    "open_questions": { "type": "array" },
    "actors": { "type": "array" },
    "permissions": { "type": "array" },
    "object_ai": { "type": "object" },
    "behaviors": {
      "type": "array",
      "minItems": 1
    },
    "acceptance": {
      "type": "array",
      "minItems": 1
    }
  }
}
